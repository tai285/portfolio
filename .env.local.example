# Copy this file to .env.local (gitignored) and fill in your Firebase
# project's web app config -- Settings (gear icon) -> Project settings
# -> scroll to "Your apps" -> the </> web app -> firebaseConfig.
#
# These values are safe to be public (Firebase enforces access via
# Firestore/Storage security rules, not by hiding this config), but
# .env.local stays out of git anyway since it's specific to your
# project and there's no reason to commit it.
#
# Without this file, the site still works fully -- it just falls back
# to the static data in src/data/, and the CMS/guestbook show a
# "not set up yet" message instead of a login form.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
