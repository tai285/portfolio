# Copy this file to .env.local (gitignored) and fill in your Firebase
# project's web app config -- Settings (gear icon) -> Project settings
# -> scroll to "Your apps" -> the </> web app -> firebaseConfig.
#
# These values are safe to be public (Firebase enforces access via the
# Firestore security rules, not by hiding this config), but .env.local
# stays out of git anyway since it's specific to your project and
# there's no reason to commit it.
#
# Without this file, the site still works fully -- it just falls back
# to the static data in src/data/, and the CMS/guestbook show a
# "not set up yet" message instead of a login form.
#
# No Storage bucket here on purpose -- Firebase requires the paid
# Blaze plan for Storage as of late 2024. Uploaded photos are instead
# compressed client-side and stored directly in Firestore, which stays
# on the free Spark plan.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
