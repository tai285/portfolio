rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Album photos uploaded via the CMS: public read (they're shown
    // on the public site), only the signed-in admin can upload.
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
